rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All school data lives under /schools/{schoolId}/**
    // Allows full access for Admin, Teachers, and Students
    match /schools/{schoolId}/{document=**} {
      allow read, write: if true;
    }

    // Global User Routing Lookup for Multi-Tenant verification
    match /users_lookup/{document=**} {
      allow read, write: if true;
    }
  }
}


