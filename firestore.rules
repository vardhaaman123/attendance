rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Strict Security Rule:
    // Only the authorized administrator account (ainapure290@gmail.com)
    // can read or write any documents or sessions.
    match /{document=**} {
      allow read, write: if request.auth != null && 
                            request.auth.token.email != null &&
                            request.auth.token.email.lower() == 'ainapure290@gmail.com';
    }
  }
}
